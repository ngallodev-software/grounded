d_at AND o.status = 'Completed'\n    JOIN customers c ON c.id = o.customer_id\n    WHERE fo.first_completed_at >= @rangeStartUtc AND fo.first_completed_at < @rangeEndExclusiveUtc\n)\nSELECT DATE_TRUNC('month', sfo.first_completed_at) AS time_bucket, COUNT(DISTINCT sfo.customer_id) AS metric\nFROM scoped_first_orders sfo\nGROUP BY DATE_TRUNC('month', sfo.first_completed_at)\nORDER BY time_bucket ASC\nLIMIT 366","parameters":{"rangeStartUtc":"2025-04-01T00:00:00+00:00","rangeEndExclusiveUtc":"2026-04-01T00:00:00+00:00"},"rowCount":12,"durationMs":31,"appliedRowLimit":366,"timeRangeStartUtc":"2025-04-01T00:00:00+00:00","timeRangeEndExclusiveUtc":"2026-04-01T00:00:00+00:00"},"answer":{"summary":"In the last 12 months, the highest monthly new customer count was 144 in August 2025, while the lowest was just 1 in March 2026.","keyPoints":["April 2025: 114 new customers","May 2025: 128 new customers","June 2025: 104 new customers","July 2025: 125 new customers","August 2025: 144 new customers"],"tableIncluded":true}},{"caseId":"time_monthly_aov","question":"Monthly average order value for the last 6 months.","executionSuccess":true,"structuralCorrectness":true,"answerGrounding":false,"passed":true,"score":0.8,"compiledSql":"SELECT COALESCE(SUM((oi.quantity * oi.unit_price) - oi.discount_amount) / NULLIF(COUNT(DISTINCT o.id), 0), 0) AS metric\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nWHERE o.status = 'Completed' AND o.order_date >= @rangeStartUtc AND o.order_date < @rangeEndExclusiveUtc","plannedQueryPlan":{"version":"1.0","questionType":"aggregate","dimension":null,"filters":[],"metric":"average_order_value","timeRange":{"preset":"last_6_months","startDate":null,"endDate":null},"timeGrain":null,"sort":{"by":"metric","direction":"desc"},"limit":null,"usePriorState":false,"resolvedFrom":{"metric":"average order value","dimension":null},"confidence":0.97},"failureCategory":"none","plannerLatencyMs":3131,"synthesisLatencyMs":1292,"totalTokensIn":5002,"totalToke