# Postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=grounded
POSTGRES_USER=grounded
POSTGRES_PORT=5432

# LLM planner
GROUNDED_PLANNER_PROVIDER=openai
GROUNDED_PLANNER_MODEL=gpt-4o-mini
GROUNDED_PLANNER_TIMEOUT_SECONDS=15

# LLM synthesizer
GROUNDED_SYNTHESIS_PROVIDER=openai
GROUNDED_SYNTHESIS_MODEL=gpt-4o-mini

# OpenAI-compatible transport
OPENAI_API_KEY=your_openai_api_key_here
GROUNDED_OPENAI_BASE_URL=https://api.openai.com/v1/
GROUNDED_OPENAI_TIMEOUT_SECONDS=15

# Anthropic transport
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROUNDED_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
GROUNDED_ANTHROPIC_VERSION=2023-06-01
GROUNDED_ANTHROPIC_TIMEOUT_SECONDS=15

GROUNDED_REPLAY_MODE=false

# Cloudflare Tunnel (Cloudflare terminates HTTPS at the edge; token from: cloudflared tunnel token <tunnel-name>)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
